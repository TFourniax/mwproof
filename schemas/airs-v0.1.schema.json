{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofmw.example/schemas/airs-v0.1.schema.json",
  "title": "AIRS v0.1 — AI Infrastructure Risk Schema",
  "type": "object",
  "required": ["id", "name", "location", "nameplate_mw", "gates"],
  "properties": {
    "id": {"type": "string"},
    "name": {"type": "string"},
    "location": {"type": "string"},
    "nameplate_mw": {"type": "number", "exclusiveMinimum": 0},
    "currency": {"type": "string"},
    "risk_factors": {"type": "array"},
    "evidence": {"type": "array"},
    "gates": {"type": "array", "minItems": 1},
    "metadata": {"type": "object"}
  }
}
